# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Django core. Generate a unique SECRET_KEY for every deployment.
DEBUG="false"
SECRET_KEY="change-me-generate-a-long-random-string"
ALLOWED_HOSTS="localhost,127.0.0.1"

# Browser origins allowed to call the API. Leave CORS_ALLOW_ALL_ORIGINS unset
# (false) in production and list the exact frontend origins.
CORS_ALLOW_ALL_ORIGINS="false"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
CSRF_TRUSTED_ORIGINS="http://localhost:3000"

# Behind a TLS-terminating proxy, keep this true (default) so cookies and
# redirects use HTTPS. The test suite runs with DEBUG=false, so it stays off
# unless explicitly enabled here.
SECURE_SSL_REDIRECT="true"

# Public URL of the Next.js frontend, used in verification / reset emails.
FRONTEND_URL="http://localhost:3000"

# Public origin that serves MEDIA files (the API host in development). Remote
# covers imported from metadata providers are downloaded into MEDIA_ROOT and
# this base is used to build the stored cover URL.
MEDIA_PUBLIC_BASE_URL="http://127.0.0.1:8000"

# Set false to keep provider cover hotlinks instead of mirroring them locally.
MIRROR_REMOTE_COVERS="true"

# Django email backend. The console backend prints emails to the server log;
# use django.core.mail.backends.smtp.EmailBackend with EMAIL_HOST,
# EMAIL_HOST_USER and EMAIL_HOST_PASSWORD for real delivery.
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
DEFAULT_FROM_EMAIL="BookstoreDZ <noreply@bookstoredz.dz>"
SEND_NOTIFICATION_EMAILS="true"

# Allow the seeded demo dashboards to call write endpoints without a token.
# Leave false in production.
ALLOW_ANONYMOUS_DEMO="false"

# External catalog metadata sources (comma separated, in priority order).
# Open Library works without a key. Google Books still works without one but
# shares a small anonymous quota and may answer HTTP 429; a key raises it.
METADATA_PROVIDERS="open_library,google_books"
GOOGLE_BOOKS_API_KEY=""
METADATA_HTTP_TIMEOUT="5"
